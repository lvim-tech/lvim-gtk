<?xml version="1.0" encoding="UTF-8"?>
<!-- lvim-gtk — Metacity/Marco window decorations. Generated by scripts/legacy.

     Metacity draws its frames from this document rather than from a stylesheet: every surface is a
     <draw_ops> built out of rectangles, lines and arcs, and the frame styles below say which one to
     paint in which state. That is why the theme is written with PRIMITIVES and not with images —
     an image-based decoration would need its own asset set per palette, and there are 48 of them.

     Used by Metacity, Marco (MATE) and GNOME Flashback. Compiz reads it too. -->
<metacity_theme>

<info>
    <name>Lvim</name>
    <author>lvim-tech</author>
    <copyright>BSD-3-Clause</copyright>
    <date>2026</date>
    <description>lvim-tech window decorations, coloured from lvim-colorscheme</description>
</info>

<!-- ── geometry ──────────────────────────────────────────────────────────────
     A hairline border and a flat title bar. `title_vertical_pad` plus the font gives the bar its
     height; the button box is square so the glyphs below stay centred at any scale. -->
<frame_geometry name="normal" title_scale="medium" rounded_top_left="0" rounded_top_right="0"
                rounded_bottom_left="0" rounded_bottom_right="0">
    <distance name="left_width" value="1"/>
    <distance name="right_width" value="1"/>
    <distance name="bottom_height" value="1"/>
    <distance name="left_titlebar_edge" value="6"/>
    <distance name="right_titlebar_edge" value="6"/>
    <distance name="title_vertical_pad" value="10"/>
    <distance name="button_width" value="26"/>
    <distance name="button_height" value="26"/>
    <border name="title_border" left="6" right="6" top="0" bottom="0"/>
    <border name="button_border" left="0" right="0" top="0" bottom="0"/>
</frame_geometry>

<!-- A maximised window has no edges to grab and no shadow to cast, so it has no border either. -->
<frame_geometry name="maximized" parent="normal" has_title="true" title_scale="medium">
    <distance name="left_width" value="0"/>
    <distance name="right_width" value="0"/>
    <distance name="bottom_height" value="0"/>
    <distance name="left_titlebar_edge" value="4"/>
    <distance name="right_titlebar_edge" value="4"/>
</frame_geometry>

<frame_geometry name="borderless" parent="normal" has_title="false">
    <distance name="title_vertical_pad" value="0"/>
    <border name="title_border" left="0" right="0" top="0" bottom="0"/>
</frame_geometry>

<!-- ── surfaces ────────────────────────────────────────────────────────────── -->
<draw_ops name="frame_focused">
    <rectangle color="@headerbar_bg_color@" x="0" y="0" width="width-1" height="height-1" filled="true"/>
    <rectangle color="@borders@" x="0" y="0" width="width-1" height="height-1" filled="false"/>
</draw_ops>

<draw_ops name="frame_unfocused">
    <rectangle color="@headerbar_backdrop_color@" x="0" y="0" width="width-1" height="height-1" filled="true"/>
    <rectangle color="@unfocused_borders@" x="0" y="0" width="width-1" height="height-1" filled="false"/>
</draw_ops>

<draw_ops name="title_focused">
    <title color="@headerbar_fg_color@" x="(0 `max` ((width - title_width) / 2))" y="((height - title_height) / 2)"/>
</draw_ops>

<draw_ops name="title_unfocused">
    <title color="@unfocused_insensitive_color@" x="(0 `max` ((width - title_width) / 2))" y="((height - title_height) / 2)"/>
</draw_ops>

<!-- ── buttons ───────────────────────────────────────────────────────────────
     Glyphs rather than plates: a bare cross, bar and square in the title bar's own foreground,
     with a filled square appearing behind them only while the pointer is on one. The accent is
     reserved for close, and only when pressed — the one button whose mistake is not undoable. -->
<!-- `blend/a/b/alpha`, not an rgba() colour: Metacity's parser knows #rrggbb, gtk: names,
     shade/ and blend/ — and nothing else. The shade colours this theme emits for CSS are
     rgba(), which lands in the XML as a string Metacity cannot read. -->
<draw_ops name="button_hover_bg">
    <rectangle color="blend/@headerbar_bg_color@/@headerbar_fg_color@/0.10" x="0" y="0" width="width-1" height="height-1" filled="true"/>
</draw_ops>

<draw_ops name="glyph_close">
    <line color="@headerbar_fg_color@" x1="width/2-4" y1="height/2-4" x2="width/2+4" y2="height/2+4" width="1"/>
    <line color="@headerbar_fg_color@" x1="width/2+4" y1="height/2-4" x2="width/2-4" y2="height/2+4" width="1"/>
</draw_ops>

<draw_ops name="glyph_close_unfocused">
    <line color="@unfocused_insensitive_color@" x1="width/2-4" y1="height/2-4" x2="width/2+4" y2="height/2+4" width="1"/>
    <line color="@unfocused_insensitive_color@" x1="width/2+4" y1="height/2-4" x2="width/2-4" y2="height/2+4" width="1"/>
</draw_ops>

<draw_ops name="glyph_maximize">
    <rectangle color="@headerbar_fg_color@" x="width/2-4" y="height/2-4" width="8" height="8" filled="false"/>
</draw_ops>

<draw_ops name="glyph_maximize_unfocused">
    <rectangle color="@unfocused_insensitive_color@" x="width/2-4" y="height/2-4" width="8" height="8" filled="false"/>
</draw_ops>

<draw_ops name="glyph_minimize">
    <line color="@headerbar_fg_color@" x1="width/2-4" y1="height/2+3" x2="width/2+4" y2="height/2+3" width="1"/>
</draw_ops>

<draw_ops name="glyph_minimize_unfocused">
    <line color="@unfocused_insensitive_color@" x1="width/2-4" y1="height/2+3" x2="width/2+4" y2="height/2+3" width="1"/>
</draw_ops>

<draw_ops name="glyph_menu">
    <icon x="width/2-8" y="height/2-8" width="16" height="16" alpha="1.0"/>
</draw_ops>

<draw_ops name="close_hover">
    <include name="button_hover_bg"/>
    <include name="glyph_close"/>
</draw_ops>
<draw_ops name="close_pressed">
    <rectangle color="@accent_bg_color@" x="0" y="0" width="width-1" height="height-1" filled="true"/>
    <line color="@accent_fg_color@" x1="width/2-4" y1="height/2-4" x2="width/2+4" y2="height/2+4" width="1"/>
    <line color="@accent_fg_color@" x1="width/2+4" y1="height/2-4" x2="width/2-4" y2="height/2+4" width="1"/>
</draw_ops>
<draw_ops name="maximize_hover">
    <include name="button_hover_bg"/>
    <include name="glyph_maximize"/>
</draw_ops>
<draw_ops name="minimize_hover">
    <include name="button_hover_bg"/>
    <include name="glyph_minimize"/>
</draw_ops>

<draw_ops name="blank"/>

<!-- ── frame styles ─────────────────────────────────────────────────────────── -->
<frame_style name="focused" geometry="normal">
    <piece position="entire_background" draw_ops="frame_focused"/>
    <piece position="title" draw_ops="title_focused"/>
    <button function="close" state="normal" draw_ops="glyph_close"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="maximize" state="normal" draw_ops="glyph_maximize"/>
    <button function="maximize" state="prelight" draw_ops="maximize_hover"/>
    <button function="maximize" state="pressed" draw_ops="maximize_hover"/>
    <button function="minimize" state="normal" draw_ops="glyph_minimize"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="minimize" state="pressed" draw_ops="minimize_hover"/>
    <button function="menu" state="normal" draw_ops="glyph_menu"/>
    <button function="menu" state="prelight" draw_ops="glyph_menu"/>
    <button function="menu" state="pressed" draw_ops="glyph_menu"/>
    <button function="shade" state="normal" draw_ops="blank"/>
    <button function="shade" state="prelight" draw_ops="blank"/>
    <button function="shade" state="pressed" draw_ops="blank"/>
    <button function="unshade" state="normal" draw_ops="blank"/>
    <button function="unshade" state="prelight" draw_ops="blank"/>
    <button function="unshade" state="pressed" draw_ops="blank"/>
    <button function="above" state="normal" draw_ops="blank"/>
    <button function="above" state="prelight" draw_ops="blank"/>
    <button function="above" state="pressed" draw_ops="blank"/>
    <button function="unabove" state="normal" draw_ops="blank"/>
    <button function="unabove" state="prelight" draw_ops="blank"/>
    <button function="unabove" state="pressed" draw_ops="blank"/>
    <button function="stick" state="normal" draw_ops="blank"/>
    <button function="stick" state="prelight" draw_ops="blank"/>
    <button function="stick" state="pressed" draw_ops="blank"/>
    <button function="unstick" state="normal" draw_ops="blank"/>
    <button function="unstick" state="prelight" draw_ops="blank"/>
    <button function="unstick" state="pressed" draw_ops="blank"/>
</frame_style>

<frame_style name="unfocused" geometry="normal">
    <piece position="entire_background" draw_ops="frame_unfocused"/>
    <piece position="title" draw_ops="title_unfocused"/>
    <button function="close" state="normal" draw_ops="glyph_close_unfocused"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="maximize" state="normal" draw_ops="glyph_maximize_unfocused"/>
    <button function="maximize" state="prelight" draw_ops="maximize_hover"/>
    <button function="maximize" state="pressed" draw_ops="maximize_hover"/>
    <button function="minimize" state="normal" draw_ops="glyph_minimize_unfocused"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="minimize" state="pressed" draw_ops="minimize_hover"/>
    <button function="menu" state="normal" draw_ops="glyph_menu"/>
    <button function="menu" state="prelight" draw_ops="glyph_menu"/>
    <button function="menu" state="pressed" draw_ops="glyph_menu"/>
    <button function="shade" state="normal" draw_ops="blank"/>
    <button function="shade" state="prelight" draw_ops="blank"/>
    <button function="shade" state="pressed" draw_ops="blank"/>
    <button function="unshade" state="normal" draw_ops="blank"/>
    <button function="unshade" state="prelight" draw_ops="blank"/>
    <button function="unshade" state="pressed" draw_ops="blank"/>
    <button function="above" state="normal" draw_ops="blank"/>
    <button function="above" state="prelight" draw_ops="blank"/>
    <button function="above" state="pressed" draw_ops="blank"/>
    <button function="unabove" state="normal" draw_ops="blank"/>
    <button function="unabove" state="prelight" draw_ops="blank"/>
    <button function="unabove" state="pressed" draw_ops="blank"/>
    <button function="stick" state="normal" draw_ops="blank"/>
    <button function="stick" state="prelight" draw_ops="blank"/>
    <button function="stick" state="pressed" draw_ops="blank"/>
    <button function="unstick" state="normal" draw_ops="blank"/>
    <button function="unstick" state="prelight" draw_ops="blank"/>
    <button function="unstick" state="pressed" draw_ops="blank"/>
</frame_style>

<frame_style name="focused_maximized" geometry="maximized" parent="focused"/>
<frame_style name="unfocused_maximized" geometry="maximized" parent="unfocused"/>
<frame_style name="focused_borderless" geometry="borderless" parent="focused"/>
<frame_style name="unfocused_borderless" geometry="borderless" parent="unfocused"/>

<!-- ── style sets ───────────────────────────────────────────────────────────── -->
<frame_style_set name="normal_style_set">
    <frame focus="yes" state="normal" resize="both" style="focused"/>
    <frame focus="no"  state="normal" resize="both" style="unfocused"/>
    <frame focus="yes" state="normal" resize="vertical" style="focused"/>
    <frame focus="no"  state="normal" resize="vertical" style="unfocused"/>
    <frame focus="yes" state="normal" resize="horizontal" style="focused"/>
    <frame focus="no"  state="normal" resize="horizontal" style="unfocused"/>
    <frame focus="yes" state="normal" resize="none" style="focused"/>
    <frame focus="no"  state="normal" resize="none" style="unfocused"/>
    <frame focus="yes" state="maximized" style="focused_maximized"/>
    <frame focus="no"  state="maximized" style="unfocused_maximized"/>
    <frame focus="yes" state="shaded" style="focused"/>
    <frame focus="no"  state="shaded" style="unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="focused_maximized"/>
    <frame focus="no"  state="maximized_and_shaded" style="unfocused_maximized"/>
</frame_style_set>

<frame_style_set name="borderless_style_set" parent="normal_style_set">
    <frame focus="yes" state="normal" resize="both" style="focused_borderless"/>
    <frame focus="no"  state="normal" resize="both" style="unfocused_borderless"/>
    <frame focus="yes" state="normal" resize="none" style="focused_borderless"/>
    <frame focus="no"  state="normal" resize="none" style="unfocused_borderless"/>
    <frame focus="yes" state="maximized" style="focused_borderless"/>
    <frame focus="no"  state="maximized" style="unfocused_borderless"/>
    <frame focus="yes" state="shaded" style="focused_borderless"/>
    <frame focus="no"  state="shaded" style="unfocused_borderless"/>
    <frame focus="yes" state="maximized_and_shaded" style="focused_borderless"/>
    <frame focus="no"  state="maximized_and_shaded" style="unfocused_borderless"/>
</frame_style_set>

<window type="normal" style_set="normal_style_set"/>
<window type="dialog" style_set="normal_style_set"/>
<window type="modal_dialog" style_set="normal_style_set"/>
<window type="menu" style_set="normal_style_set"/>
<window type="utility" style_set="normal_style_set"/>
<window type="border" style_set="borderless_style_set"/>

</metacity_theme>
