# lvim-gtk — GTK2. Generated by scripts/legacy; edit src/templates/gtk-2.0/ instead.
#
# GTK2 has no stylesheet. It has `gtk-color-scheme`, a handful of named colours that its built-in
# drawing code consults, and an rc language for overriding widget properties. That is a narrower
# instrument than CSS, and it is also why this file is short where the GTK3 half is long: GTK2 DOES
# paint its own widgets, so it only needs to be told which colours to use.
#
# No pixmap engine, deliberately. The usual way to make GTK2 resemble a modern theme is to draw
# every widget state as a nine-slice image and point the pixmap engine at a few hundred of them.
# That buys a closer imitation and costs a per-palette asset set — 48 of them here — that would
# have to be regenerated on every colour change. The built-in engine reading the right colours gets
# most of the way there and stays correct automatically.

gtk-color-scheme = "fg_color:@window_fg_color@\nbg_color:@window_bg_color@"
gtk-color-scheme = "text_color:@view_fg_color@\nbase_color:@view_bg_color@"
gtk-color-scheme = "selected_fg_color:@theme_selected_fg_color@\nselected_bg_color:@theme_selected_bg_color@"
gtk-color-scheme = "titlebar_fg_color:@headerbar_fg_color@\ntitlebar_bg_color:@headerbar_bg_color@"
gtk-color-scheme = "menu_color:@popover_bg_color@\nmenu_fg_color:@popover_fg_color@"
gtk-color-scheme = "tooltip_fg_color:@window_fg_color@\ntooltip_bg_color:@popover_bg_color@"
gtk-color-scheme = "link_color:@accent_color@\nvisited_link_color:@accent_color@"
gtk-color-scheme = "insensitive_fg_color:@insensitive_fg_color@\nborder_color:@borders@"

gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1

include "main.rc"
