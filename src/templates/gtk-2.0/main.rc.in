# lvim-gtk — GTK2 widget styles. Generated by scripts/legacy.
#
# Everything here is either a colour GTK2 cannot derive on its own, or a metric. Widget SHAPE is
# left to GTK2's own drawing: it is from an era whose look cannot be talked into being flat by an
# rc file, and pretending otherwise is what the pixmap engine is for (see gtkrc for why not).

style "lvim-default" {
    xthickness = 1
    ythickness = 1

    fg[NORMAL]        = @window_fg_color@
    fg[PRELIGHT]      = @window_fg_color@
    fg[SELECTED]      = @theme_selected_fg_color@
    fg[ACTIVE]        = @window_fg_color@
    fg[INSENSITIVE]   = @insensitive_fg_color@

    bg[NORMAL]        = @window_bg_color@
    bg[PRELIGHT]      = @headerbar_bg_color@
    bg[SELECTED]      = @theme_selected_bg_color@
    bg[ACTIVE]        = @headerbar_bg_color@
    bg[INSENSITIVE]   = @window_bg_color@

    base[NORMAL]      = @view_bg_color@
    base[PRELIGHT]    = @theme_selected_bg_color@
    base[SELECTED]    = @theme_selected_bg_color@
    base[ACTIVE]      = @theme_unfocused_selected_bg_color@
    base[INSENSITIVE] = @insensitive_base_color@

    text[NORMAL]      = @view_fg_color@
    text[PRELIGHT]    = @view_fg_color@
    text[SELECTED]    = @theme_selected_fg_color@
    text[ACTIVE]      = @theme_selected_fg_color@
    text[INSENSITIVE] = @insensitive_fg_color@

    GtkButton::default-border          = { 0, 0, 0, 0 }
    GtkButton::default-outside-border  = { 0, 0, 0, 0 }
    GtkButton::inner-border            = { 3, 3, 3, 3 }
    GtkButtonBox::child-min-width      = 80
    GtkButtonBox::child-min-height     = 26

    GtkCheckButton::indicator-size     = 15
    GtkCheckMenuItem::indicator-size   = 13

    GtkEntry::inner-border             = { 4, 4, 3, 3 }
    GtkEntry::state-hint               = 1

    GtkMenuBar::internal-padding       = 0
    GtkMenuBar::shadow-type            = none
    GtkMenu::horizontal-padding        = 0
    GtkMenu::vertical-padding          = 2
    GtkMenuItem::arrow-scaling         = 0.5

    GtkNotebook::tab-overlap           = 0
    GtkPaned::handle-size              = 4

    GtkRange::slider-width             = 12
    GtkRange::stepper-size             = 0
    GtkRange::trough-border            = 0
    GtkScrollbar::has-backward-stepper = 0
    GtkScrollbar::has-forward-stepper  = 0
    GtkScrollbar::min-slider-length    = 32
    GtkScrolledWindow::scrollbar-spacing = 0

    GtkStatusbar::shadow-type          = none
    GtkToolbar::internal-padding       = 2
    GtkTreeView::vertical-separator    = 2
    GtkWidget::focus-line-width        = 1
    GtkWidget::link-color              = @accent_color@
    GtkWidget::visited-link-color      = @accent_color@
    GtkWidget::tooltip-alpha           = 255
}

# The titlebar and the toolbars read as chrome, so they take the header surface rather than the
# window one — the same split the GTK3 half makes.
style "lvim-chrome" = "lvim-default" {
    bg[NORMAL]        = @headerbar_bg_color@
    fg[NORMAL]        = @headerbar_fg_color@
}

# Menus and tooltips sit above the window and take the raised surface.
style "lvim-menu" = "lvim-default" {
    bg[NORMAL]        = @popover_bg_color@
    fg[NORMAL]        = @popover_fg_color@
    text[NORMAL]      = @popover_fg_color@
}

style "lvim-menuitem" = "lvim-menu" {
    bg[PRELIGHT]      = @theme_selected_bg_color@
    fg[PRELIGHT]      = @theme_selected_fg_color@
    text[PRELIGHT]    = @theme_selected_fg_color@
}

style "lvim-tooltip" = "lvim-default" {
    xthickness = 6
    ythickness = 4
    bg[NORMAL]        = @popover_bg_color@
    fg[NORMAL]        = @popover_fg_color@
}

# Content lives on the view surface: lists, trees, text.
style "lvim-view" = "lvim-default" {
    bg[NORMAL]        = @view_bg_color@
    base[NORMAL]      = @view_bg_color@
}

style "lvim-entry" = "lvim-default" {
    xthickness = 4
    ythickness = 4
    bg[NORMAL]        = @view_bg_color@
}

style "lvim-scrollbar" = "lvim-default" {
    bg[NORMAL]        = @view_bg_color@
    bg[PRELIGHT]      = @window_fg_color@
    bg[ACTIVE]        = @accent_bg_color@
    bg[INSENSITIVE]   = @view_bg_color@
}

style "lvim-progress" = "lvim-default" {
    bg[PRELIGHT]      = @accent_bg_color@
    fg[PRELIGHT]      = @accent_fg_color@
}

class "GtkWidget"        style "lvim-default"
class "GtkEntry"         style "lvim-entry"
class "GtkSpinButton"    style "lvim-entry"
class "GtkScrollbar"     style "lvim-scrollbar"
class "GtkProgressBar"   style "lvim-progress"
class "GtkToolbar"       style "lvim-chrome"
class "GtkHandleBox"     style "lvim-chrome"
class "GtkMenuBar"       style "lvim-chrome"

widget_class "*<GtkMenu>*"        style "lvim-menu"
widget_class "*<GtkMenuItem>*"    style "lvim-menuitem"
widget_class "*<GtkTreeView>*"    style "lvim-view"
widget_class "*<GtkTextView>*"    style "lvim-view"
widget_class "*<GtkIconView>*"    style "lvim-view"
widget "gtk-tooltip*"             style "lvim-tooltip"
