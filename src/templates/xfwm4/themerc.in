# lvim-gtk — XFWM4 window decorations. Generated by scripts/legacy.
#
# XFWM4 takes its title bar from key=value here and its buttons from image files beside it. This
# ships the text half: colours, metrics and title layout, which is what decides whether a window
# looks like it belongs to the theme. The button GRAPHICS are still XFWM4's own defaults — writing
# them means emitting ~30 small images per palette, and there are 48 palettes; that is a generator
# of its own and it is noted as owed rather than half-done here.
#
# The gradients are flat on purpose: each pair is the same colour twice, so XFWM4's two-stop fill
# produces one tone and the title bar matches the GTK headerbar exactly rather than approximately.

active_text_color=@headerbar_fg_color@
active_text_shadow_color=@headerbar_bg_color@
inactive_text_color=@unfocused_insensitive_color@
inactive_text_shadow_color=@headerbar_backdrop_color@

active_color_1=@headerbar_bg_color@
active_color_2=@headerbar_bg_color@
active_hilight_1=@headerbar_bg_color@
active_hilight_2=@headerbar_bg_color@
active_shadow_1=@borders@
active_shadow_2=@borders@
active_mid_1=@headerbar_bg_color@
active_mid_2=@headerbar_bg_color@

inactive_color_1=@headerbar_backdrop_color@
inactive_color_2=@headerbar_backdrop_color@
inactive_hilight_1=@headerbar_backdrop_color@
inactive_hilight_2=@headerbar_backdrop_color@
inactive_shadow_1=@unfocused_borders@
inactive_shadow_2=@unfocused_borders@
inactive_mid_1=@headerbar_backdrop_color@
inactive_mid_2=@headerbar_backdrop_color@

button_offset=4
button_spacing=0
show_app_icon=false
full_width_title=true
frame_border_top=0
maximized_offset=0

title_horizontal_offset=2
title_shadow_active=false
title_shadow_inactive=false
title_vertical_offset_active=0
title_vertical_offset_inactive=0

shadow_delta_height=2
shadow_delta_width=0
shadow_delta_x=0
shadow_delta_y=-5
shadow_opacity=40
