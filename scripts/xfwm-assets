#!/usr/bin/env python3
"""lvim-gtk xfwm-assets — draw XFWM4's decoration images.

XFWM4 takes its titlebar geometry from themerc and everything it PAINTS from image files beside it:
one per frame edge, and one per button per state. There is no stylesheet and no colour anywhere in
the format — a red close button and a green one are two different pictures. So a theme with 48
palettes needs 48 sets, which is why this is a generator and not a folder of assets.

WHY XPM, and not the SVG every modern theme ships. GdkPixbuf loads SVG only when the librsvg loader
is installed; XPM it has always understood. XPM's usual drawback is that it has one bit of
transparency and no blending, which normally rules out an antialiased glyph — but not here: this
theme's titlebar is flat and its colour is known at generation time, so the glyphs are rendered
ONTO that colour and every pixel is opaque. The limitation costs nothing when there is nothing to
blend against.

Shapes are drawn at 3x and averaged down, so the diagonals of the close cross are smooth.

    scripts/xfwm-assets build/Lvim-EverforestDark
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SS = 3  # supersampling factor


# ── inputs ───────────────────────────────────────────────────────────────────

def read_colors(theme):
    css = (theme / "gtk-3.0/gtk.css").read_text(encoding="utf-8")
    out = {}
    for name, val in re.findall(r"@define-color\s+([A-Za-z0-9_]+)\s+(#[0-9a-fA-F]{6})\s*;", css):
        out[name] = (int(val[1:3], 16), int(val[3:5], 16), int(val[5:7], 16))
    if not out:
        sys.exit(f"no @define-color in {theme} — run scripts/build first")
    return out


def read_metrics():
    """The px values from _config.scss, so the images agree with themerc about the title height."""
    txt = (ROOT / "src/sass/_config.scss").read_text(encoding="utf-8")
    out = {}
    for key, val in re.findall(r"^\$([a-z0-9-]+):\s*(\d+)px\s*!default;", txt, re.MULTILINE):
        out[key] = int(val)
    return out


def mix(a, b, t):
    """b over a at t."""
    return tuple(round(a[i] + (b[i] - a[i]) * t) for i in range(3))


# ── a very small rasteriser ──────────────────────────────────────────────────

class Canvas:
    """RGB only. Everything lands on a known background, so there is no alpha channel to keep."""

    def __init__(self, w, h, bg):
        self.w, self.h = w, h
        self.px = [[bg] * (w * SS) for _ in range(h * SS)]

    def _set(self, x, y, c):
        if 0 <= x < self.w * SS and 0 <= y < self.h * SS:
            self.px[y][x] = c

    def rect(self, x, y, w, h, color, width=0):
        x, y, w, h = (v * SS for v in (x, y, w, h))
        if width == 0:
            for yy in range(y, y + h):
                for xx in range(x, x + w):
                    self._set(xx, yy, color)
        else:
            t = width * SS
            for yy in range(y, y + h):
                for xx in range(x, x + w):
                    if xx < x + t or xx >= x + w - t or yy < y + t or yy >= y + h - t:
                        self._set(xx, yy, color)

    def line(self, x1, y1, x2, y2, color, width=1):
        """A thick line as a swept disc — round ends, and it is the diagonals that need this."""
        x1, y1, x2, y2 = (v * SS for v in (x1, y1, x2, y2))
        r = (width * SS) / 2.0
        steps = int(max(abs(x2 - x1), abs(y2 - y1)) * 2) + 1
        for s in range(steps + 1):
            t = s / steps
            cx, cy = x1 + (x2 - x1) * t, y1 + (y2 - y1) * t
            for yy in range(int(cy - r) - 1, int(cy + r) + 2):
                for xx in range(int(cx - r) - 1, int(cx + r) + 2):
                    if (xx + 0.5 - cx) ** 2 + (yy + 0.5 - cy) ** 2 <= r * r:
                        self._set(xx, yy, color)

    def disc(self, cx, cy, r, color):
        cx, cy, r = cx * SS, cy * SS, r * SS
        for yy in range(int(cy - r) - 1, int(cy + r) + 2):
            for xx in range(int(cx - r) - 1, int(cx + r) + 2):
                if (xx + 0.5 - cx) ** 2 + (yy + 0.5 - cy) ** 2 <= r * r:
                    self._set(xx, yy, color)

    def down(self):
        """Average each SSxSS block — this is the whole of the antialiasing."""
        out = []
        for y in range(self.h):
            row = []
            for x in range(self.w):
                r = g = b = 0
                for dy in range(SS):
                    for dx in range(SS):
                        p = self.px[y * SS + dy][x * SS + dx]
                        r, g, b = r + p[0], g + p[1], b + p[2]
                n = SS * SS
                row.append((round(r / n), round(g / n), round(b / n)))
            out.append(row)
        return out


CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#.+@$%&*=-"


def xpm(name, rows):
    """Two characters per pixel: antialiasing produces far more than the 72 a single char allows."""
    palette, order = {}, []
    for row in rows:
        for c in row:
            if c not in palette:
                i = len(order)
                palette[c] = CHARS[i // len(CHARS)] + CHARS[i % len(CHARS)]
                order.append(c)
    h, w = len(rows), len(rows[0])
    out = ["/* XPM */", f"static char * {name}[] = {{",
           f'"{w} {h} {len(order)} 2",']
    for c in order:
        out.append(f'"{palette[c]}\tc #{c[0]:02x}{c[1]:02x}{c[2]:02x}",')
    for i, row in enumerate(rows):
        line = '"' + "".join(palette[c] for c in row) + '"'
        out.append(line + ("," if i < h - 1 else ""))
    out.append("};")
    return "\n".join(out) + "\n"


# ── the theme's own pictures ─────────────────────────────────────────────────

def glyph(kind, size, gl, bg, fg):
    """One titlebar button. `gl` is the glyph's own extent, centred in a `size` square."""
    c = Canvas(size, size, bg)
    m = size / 2.0
    h = gl / 2.0
    w = max(1, round(size / 16))
    if kind == "close":
        c.line(m - h, m - h, m + h, m + h, fg, w)
        c.line(m + h, m - h, m - h, m + h, fg, w)
    elif kind == "maximize":
        c.rect(round(m - h), round(m - h), gl, gl, fg, width=w)
    elif kind == "maximize-toggled":
        # Two offset outlines: restore, drawn as the window stepping back out of the screen.
        c.rect(round(m - h + 2), round(m - h), gl - 2, gl - 2, fg, width=w)
        c.rect(round(m - h), round(m - h + 2), gl - 2, gl - 2, bg, width=0)
        c.rect(round(m - h), round(m - h + 2), gl - 2, gl - 2, fg, width=w)
    elif kind == "hide":
        c.line(m - h, m + h - w, m + h, m + h - w, fg, w)
    elif kind in ("shade", "shade-toggled"):
        # `shade` rolls the window UP into its titlebar, so it points up; the toggled form is
        # what you press once it is already shaded, and it rolls back down.
        d = 1 if kind == "shade" else -1
        c.line(m - h, m + d * h / 2, m, m - d * h / 2, fg, w)
        c.line(m, m - d * h / 2, m + h, m + d * h / 2, fg, w)
    elif kind == "stick":
        c.disc(m, m, max(1.5, gl / 5.0), fg)
    elif kind == "stick-toggled":
        c.disc(m, m, max(2.0, gl / 3.5), fg)
    elif kind == "menu":
        for i in (-1, 0, 1):
            c.line(m - h, m + i * (gl / 3.0), m + h, m + i * (gl / 3.0), fg, w)
    return c.down()


def solid(w, h, color):
    return Canvas(w, h, color).down()


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: scripts/xfwm-assets build/<Name>")
    theme = pathlib.Path(sys.argv[1])
    col, met = read_colors(theme), read_metrics()

    out = theme / "xfwm4"
    out.mkdir(parents=True, exist_ok=True)

    title_h = met.get("wm-title-height", 34)
    btn = met.get("wm-button-size", 26)
    gl = met.get("wm-glyph", 10)
    border = met.get("wm-border", 1)

    # Two title bars, and the button plate that appears under a pointer.
    bar = {"active": col["headerbar_bg_color"], "inactive": col["headerbar_backdrop_color"]}
    ink = {"active": col["headerbar_fg_color"], "inactive": col["unfocused_insensitive_color"]}
    edge = {"active": col["borders"], "inactive": col["unfocused_borders"]}
    # Not `headerbar_shade_color`: that one is emitted as rgba() for CSS, and there is nothing
    # here to composite it against later. The hover plate is mixed now, from the two colours
    # that are actually on screen — which is what the CSS overlay resolves to anyway.
    plate = mix(bar["active"], ink["active"], 0.10)

    files = {}

    for st in ("active", "inactive"):
        files[f"title-{st}"] = solid(6, title_h, bar[st])
        files[f"top-left-{st}"] = solid(6, title_h, bar[st])
        files[f"top-right-{st}"] = solid(6, title_h, bar[st])
        files[f"left-{st}"] = solid(border, 16, edge[st])
        files[f"right-{st}"] = solid(border, 16, edge[st])
        files[f"bottom-{st}"] = solid(16, border, edge[st])
        files[f"bottom-left-{st}"] = solid(border, border, edge[st])
        files[f"bottom-right-{st}"] = solid(border, border, edge[st])

    functions = ("menu", "stick", "stick-toggled", "shade", "shade-toggled",
                 "hide", "maximize", "maximize-toggled", "close")

    for fn in functions:
        for st in ("active", "inactive", "prelight", "pressed"):
            if st == "inactive":
                bg, fg = bar["inactive"], ink["inactive"]
            elif st == "prelight":
                bg, fg = plate, ink["active"]
            elif st == "pressed":
                # Close is the one button whose mistake cannot be undone, so it is the one that
                # announces itself under the finger.
                bg = col["accent_bg_color"] if fn == "close" else mix(plate, ink["active"], 0.12)
                fg = col["accent_fg_color"] if fn == "close" else ink["active"]
            else:
                bg, fg = bar["active"], ink["active"]
            files[f"{fn}-{st}"] = glyph(fn, btn, gl, bg, fg)

    # `title-1` … `title-5` are the segments either side of the label; xfwm4 asks for all five and
    # this theme has nothing to say about the difference, so they are the same picture.
    for st in ("active", "inactive"):
        for i in range(1, 6):
            files[f"title-{i}-{st}"] = files[f"title-{st}"]

    for name, rows in files.items():
        (out / f"{name}.xpm").write_text(xpm(name.replace("-", "_"), rows), encoding="utf-8")

    print(f"  xfwm4: {len(files)} images ({btn}px buttons, {title_h}px title bar)")


main()
