#!/usr/bin/env python3
"""lvim-gtk palettes — convert lvim-colorscheme's styles into SCSS.

Neovim does the reading, and it has to. Twelve of the styles are not tables at all: a `*_light`
file returns a FUNCTION that computes the palette from another style at call time. Parsing the Lua
text therefore yields the dark styles and silently drops every light one — which is exactly what a
first attempt here did, producing 36 palettes and no warning that a third was missing.

    scripts/dump-palettes.lua   evaluates every style and writes the raw colours as JSON
    this script                 turns that into palettes/<style>.scss

WHERE THE COLORSCHEME COMES FROM. A local checkout wins when there is one, because regenerating
after editing a palette is the whole point of running this. With no checkout the sources are pulled
straight from the repo into a cache directory — building this theme should not require cloning
another one. Order: --colorscheme PATH, then $LVIM_COLORSCHEME, then ~/lvim-tech/lvim-colorscheme,
then the repo. --repo forces the last one, which is also how you check the theme against what is
actually published rather than against your working tree.

    scripts/palettes                      # local checkout if present, else download
    scripts/palettes --repo               # always the published sources
    scripts/palettes --repo --ref v2.1.0  # a tag or branch
    scripts/palettes --colorscheme ~/src/lvim-colorscheme
"""
import argparse
import io
import json
import os
import pathlib
import subprocess
import sys
import tarfile
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "palettes"
DUMP = pathlib.Path("/tmp/lvim-gtk-palettes.json")

REPO = "lvim-tech/lvim-colorscheme"
LOCAL = pathlib.Path.home() / "lvim-tech" / "lvim-colorscheme"
CACHE = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")) / "lvim-gtk"

def fetch(ref):
    """Download the colorscheme sources and return the directory they unpacked into."""
    url = f"https://codeload.github.com/{REPO}/tar.gz/refs/heads/{ref}"
    print(f"  fetching {REPO}@{ref} …")
    # A ref is a branch or a tag and codeload puts them at different paths, with no way to ask which
    # without a second request. Trying the branch and falling through on a 404 is one round trip in
    # the common case; `OSError` covers both HTTPError and the connection failing outright.
    try:
        with urllib.request.urlopen(url, timeout=60) as r:
            blob = r.read()
    except OSError as e:
        try:
            with urllib.request.urlopen(
                f"https://codeload.github.com/{REPO}/tar.gz/refs/tags/{ref}", timeout=60) as r:
                blob = r.read()
        except OSError:
            sys.exit(f"could not download {REPO}@{ref}: {e}")

    CACHE.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tar:
        # The archive has one top-level directory; keep its name so refs do not collide.
        top = tar.getnames()[0].split("/")[0]
        dest = CACHE / top
        if dest.exists():
            import shutil
            shutil.rmtree(dest)
        tar.extractall(CACHE, filter="data")
    print(f"  unpacked into {dest}")
    return dest

def resolve(args):
    if args.colorscheme:
        p = pathlib.Path(args.colorscheme).expanduser()
        if not (p / "lua/lvim-colorscheme/colors").is_dir():
            sys.exit(f"{p} has no lua/lvim-colorscheme/colors")
        return p
    if not args.repo:
        env = os.environ.get("LVIM_COLORSCHEME")
        if env and (pathlib.Path(env) / "lua/lvim-colorscheme/colors").is_dir():
            return pathlib.Path(env)
        if (LOCAL / "lua/lvim-colorscheme/colors").is_dir():
            print(f"  local checkout: {LOCAL}")
            return LOCAL
    return fetch(args.ref)

def dump(source):
    env = dict(os.environ, LVIM_COLORSCHEME=str(source), LVIM_GTK_PALETTES_JSON=str(DUMP))
    DUMP.unlink(missing_ok=True)
    r = subprocess.run(
        ["nvim", "--clean", "--headless", "-c", f"luafile {ROOT / 'scripts/dump-palettes.lua'}", "-c", "qa!"],
        capture_output=True, text=True, env=env, check=False)
    if not DUMP.is_file():
        sys.exit("nvim failed to dump the palettes:\n" + r.stderr[-400:])
    return json.loads(DUMP.read_text())

def scss(style, colors):
    head = [
        "// lvim-gtk palette — GENERATED by scripts/palettes, do not edit.",
        "//",
        "// Raw colours only: nothing here decides what any of them is for. That is _semantic.scss,",
        "// which measures each one against the background and lifts it until it is legible — editor",
        "// palettes are deliberately low-contrast and cannot be used on a desktop as they are.",
        "//",
        f"// style: {style}",
        "",
        f"$style:         '{style}';",
        "",
    ]
    body = [f"${k.replace(chr(95), chr(45))}:{chr(32) * max(1, 15 - len(k))}{v};" for k, v in sorted(colors.items())]
    return "\n".join(head + body) + "\n"

def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--repo", action="store_true", help="always the published sources, never a local checkout")
    ap.add_argument("--ref", default="main", help="branch or tag (default: main)")
    ap.add_argument("--colorscheme", help="path to a specific lvim-colorscheme checkout")
    args = ap.parse_args()

    OUT.mkdir(exist_ok=True)
    data = dump(resolve(args))
    n = 0
    for style, colors in sorted(data.items()):
        if "bg" not in colors or "fg" not in colors:
            print(f"  skipped (incomplete palette): {style}")
            continue
        (OUT / f"{style}.scss").write_text(scss(style, colors), encoding="utf-8")
        n += 1
    light = sum(1 for s in data if s.endswith("_light"))
    print(f"  generated: {n} palettes ({light} light) in {OUT}")

main()
